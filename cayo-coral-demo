<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Cayo Coral 360</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@300;400;500;600&display=swap">
<script>
(function(){var l='es';try{var s=localStorage.getItem('cayo360-lang');if(s==='en'||s==='es'){l=s}}catch(e){}document.documentElement.setAttribute('lang',l)})();
</script>
<style>
/* Layout: dark, quiet and photographic like a product launch page. A full-bleed hero that is a live 360 viewer (WebGL) with a glass price card and arrows beside the price; alternating place rows; feature grid; glass booking planner; route map; review mosaic; FAQ; giant faded wordmark footer. Single dark look by choice. */
:root{
  --bg:#060a0b;
  --bg2:#0b1315;
  --fg:#ece9e2;
  --muted:#9aa8a7;
  --dim:#6c7b7a;
  --line:rgba(255,255,255,.11);
  --glass:rgba(10,18,20,.52);
  --card:rgba(255,255,255,.035);
  --amber:#f0a45a;
  --amber-soft:#ffd9a8;
  --sea:#4cc9c4;
  --font-display:"Instrument Serif","Iowan Old Style","Georgia",serif;
  --font-body:"Hanken Grotesk",system-ui,-apple-system,"Segoe UI",sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--bg);color:var(--fg);
  font-family:var(--font-body);font-weight:300;font-size:16px;line-height:1.65;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-block:0 92px;
}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:linear-gradient(180deg,rgba(6,10,11,.7),rgba(6,10,11,0));z-index:60;pointer-events:none}
html[lang="es"] [data-l="en"],html[lang="en"] [data-l="es"]{display:none}
.wrap{max-width:1160px;margin:0 auto}
h1,h2,h3{font-family:var(--font-display);font-weight:400;margin:0;text-wrap:balance;line-height:1.02;letter-spacing:-.015em}
h1 em,h2 em{font-style:italic;color:var(--amber-soft)}
p{margin:0}
a{color:inherit}
button{font-family:inherit}
:focus-visible{outline:2px solid var(--amber);outline-offset:3px;border-radius:8px}
.eyebrow{font-size:12px;font-weight:500;letter-spacing:.24em;text-transform:uppercase;color:var(--muted)}

.sample{margin-inline:calc(-1 * max(16px,env(safe-area-inset-left,0px)));background:#0d1618;color:var(--muted);font-size:12.5px;text-align:center;padding:8px 14px;border-bottom:1px solid var(--line)}

/* nav */
nav{position:fixed;z-index:50;top:calc(env(safe-area-inset-top,0px) + 14px);left:50%;transform:translateX(-50%);width:min(calc(100% - 32px),980px);
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  background:var(--glass);-webkit-backdrop-filter:blur(18px) saturate(1.4);backdrop-filter:blur(18px) saturate(1.4);
  border:1px solid var(--line);border-radius:999px;padding:8px 8px 8px 20px}
.brand{font-family:var(--font-display);font-size:24px;display:flex;align-items:center;gap:9px;text-decoration:none;letter-spacing:-.01em}
.brand svg{width:22px;height:22px}
.links{display:flex;gap:4px;font-weight:400;font-size:14.5px}
.links a{text-decoration:none;color:var(--muted);padding:8px 14px;border-radius:999px;transition:color .2s ease,background .2s ease}
.links a:hover{color:var(--fg);background:rgba(255,255,255,.07)}
.right{display:flex;align-items:center;gap:8px}
.lang{display:flex;background:rgba(255,255,255,.06);border-radius:999px;padding:3px}
.lang button{border:0;background:transparent;font:500 11.5px var(--font-body);letter-spacing:.12em;color:var(--muted);padding:7px 11px;border-radius:999px;cursor:pointer}
.lang button[aria-pressed="true"]{background:var(--fg);color:#0a1214}

/* buttons */
.btn{position:relative;overflow:hidden;isolation:isolate;display:inline-flex;align-items:center;justify-content:center;gap:9px;text-decoration:none;font:500 14.5px var(--font-body);padding:13px 22px;border-radius:999px;border:0;cursor:pointer;min-width:0;transition:transform .2s ease,box-shadow .3s ease,background .2s ease}
.btn::before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.55) 50%,transparent 70%);transform:translateX(-130%)}
.btn:hover::before{transform:translateX(130%);transition:transform .8s ease}
.btn:active{transform:scale(.97)!important}
.btn .arr{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;transition:transform .25s ease}
.btn:hover .arr{transform:translateX(4px)}
.btn.light{background:var(--fg);color:#0a1214;box-shadow:0 10px 30px -12px rgba(255,255,255,.5)}
.btn.glass{background:rgba(255,255,255,.08);color:var(--fg);border:1px solid var(--line);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.btn.amber{background:linear-gradient(135deg,#ffc07a,#f0a45a);color:#1a0e03;box-shadow:0 12px 28px -12px rgba(240,164,90,.8)}
.btn.small{padding:10px 16px;font-size:13.5px}
.btn:disabled{opacity:.5;cursor:not-allowed}

/* hero viewer */
.hero{position:relative;isolation:isolate;overflow:hidden;margin-inline:calc(-1 * max(16px,env(safe-area-inset-left,0px)));
  min-height:clamp(700px,100vh,880px);
  background:linear-gradient(180deg,#0b2236 0%,#1c4a5e 40%,#f0a46e 47%,#0f6d78 49%,#06323a 80%,#060a0b 100%);
  display:flex;flex-direction:column;justify-content:space-between;
  padding:92px max(16px,env(safe-area-inset-left,0px)) clamp(24px,4vh,44px)}
[hidden]{display:none!important}
.hero canvas{position:absolute;inset:0;width:100%;height:100%;display:block;z-index:0;cursor:grab;touch-action:none}
.hero.drag canvas{cursor:grabbing}
.hero::before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(4,10,12,.62) 0%,rgba(4,10,12,0) 38%,rgba(4,10,12,0) 62%,rgba(6,10,11,.85) 92%,var(--bg) 100%)}
.hero-ui{position:relative;z-index:2;pointer-events:none;max-width:1160px;width:100%;margin:0 auto;display:flex;flex-direction:column;gap:20px;flex:1;justify-content:space-between}
.hero-ui .copy{text-align:center;display:grid;gap:12px;justify-items:center}
.hero-ui .copy h1{font-size:clamp(40px,6.2vw,82px);max-width:19ch;text-shadow:0 8px 50px rgba(0,0,0,.35)}
.hero-ui .copy p.sub{color:rgba(236,233,226,.9);font-size:clamp(15px,1.5vw,18px);max-width:46ch;text-shadow:0 2px 18px rgba(0,0,0,.6)}
.hero-ui .cta{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;pointer-events:auto;margin-top:4px}
.hero-ui .bottom{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap}

/* price card */
.pc{pointer-events:auto;width:min(410px,100%);background:var(--glass);-webkit-backdrop-filter:blur(20px) saturate(1.3);backdrop-filter:blur(20px) saturate(1.3);
  border:1px solid rgba(255,255,255,.16);border-radius:26px;padding:18px 22px 20px;display:grid;gap:8px;box-shadow:0 30px 60px -30px rgba(0,0,0,.7)}
.pc-top{display:flex;align-items:center;justify-content:space-between;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);font-variant-numeric:tabular-nums}
.pc-top .b360{border:1px solid rgba(255,255,255,.25);border-radius:999px;padding:3px 10px;color:var(--fg);letter-spacing:.12em}
.pc h2{font-size:clamp(28px,3.4vw,36px)}
.pc .meta{color:var(--muted);font-size:14px;font-variant-numeric:tabular-nums}
.pc-row{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-top:4px}
.pc-price{position:relative;display:flex;align-items:baseline;gap:4px;font-family:var(--font-display);line-height:.9;padding-bottom:10px}
.pc-price .cur{font-size:30px;color:var(--amber);align-self:flex-start;margin-top:8px}
.pc-price .num{font-size:72px;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.pc-price small{font:300 13px var(--font-body);color:var(--muted);margin-left:6px;align-self:flex-end;padding-bottom:12px}
.pc-price::after{content:"";position:absolute;left:0;bottom:0;height:2px;width:100%;background:linear-gradient(90deg,var(--amber),rgba(240,164,90,0));transform-origin:left;transform:scaleX(1)}
.pc-price.swap::after{animation:sweep .9s cubic-bezier(.2,.7,.2,1)}
@keyframes sweep{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.swap{animation:swapIn .6s cubic-bezier(.2,.7,.2,1) both}
@keyframes swapIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.arrows{display:flex;gap:8px;padding-bottom:12px}
.arrows button{width:46px;height:46px;border-radius:50%;border:1px solid rgba(255,255,255,.24);background:rgba(255,255,255,.07);color:var(--fg);cursor:pointer;display:grid;place-items:center;transition:background .2s ease,color .2s ease,transform .2s ease}
.arrows button:hover{background:var(--fg);color:#0a1214}
.arrows button:active{transform:scale(.92)}
.arrows svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.pc .inc{color:rgba(236,233,226,.8);font-size:14px}
.pc .btn{margin-top:4px}
.dots{display:flex;gap:7px;align-items:center}
.dots button{width:8px;height:8px;border-radius:50%;border:0;padding:0;background:rgba(255,255,255,.3);cursor:pointer;transition:width .3s ease,background .3s ease}
.dots button[aria-current="true"]{width:26px;border-radius:999px;background:var(--amber)}
.side{pointer-events:auto;display:grid;gap:12px;justify-items:end;text-align:right}
.hint{font-size:13px;color:rgba(236,233,226,.8);display:flex;align-items:center;gap:8px}
.hint svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.photo-ctl{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}

section{padding-block:clamp(56px,9vw,110px)}
.head{display:grid;gap:14px;margin-bottom:44px;justify-items:center;text-align:center}
.head h2{font-size:clamp(34px,5.6vw,68px);max-width:18ch}
.head p.sub{color:var(--muted);max-width:52ch;font-size:17px}

/* reveal: content stays visible and only slides up */
.rv:not(.in){transform:translateY(26px)}
.rv.in{animation:rise .8s cubic-bezier(.2,.7,.2,1) both}
@keyframes rise{from{transform:translateY(26px)}to{transform:none}}

/* place rows */
.rows{display:grid;gap:22px}
.row{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(20px,4vw,56px);align-items:center;background:var(--card);border:1px solid var(--line);border-radius:30px;padding:clamp(14px,2vw,22px);min-width:0}
.row:nth-child(even) .thumb{order:2}
.thumb{position:relative;border-radius:22px;overflow:hidden;aspect-ratio:16/10;min-width:0;border:1px solid var(--line)}
.t1{background:radial-gradient(70% 60% at 62% 38%,rgba(255,214,160,.8),rgba(255,214,160,0) 60%),linear-gradient(180deg,#3d6b80,#c79f86 48%,#1b6f78 49%,#07323a)}
.t2{background:radial-gradient(60% 50% at 30% 30%,rgba(255,255,255,.7),rgba(255,255,255,0) 55%),linear-gradient(180deg,#2f86c4,#aee3ee 48%,#2cc3b6 49%,#e6d9b0 100%)}
.t3{background:radial-gradient(60% 50% at 50% 52%,rgba(255,150,80,.95),rgba(255,150,80,0) 60%),linear-gradient(180deg,#141a3f,#e0603d 48%,#1a2a48 49%,#080f20)}
.thumb .chip{position:absolute;left:14px;bottom:14px;display:flex;align-items:center;gap:8px;background:var(--glass);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:8px 14px;font-size:13px}
.row .txt{display:grid;gap:14px;padding:clamp(4px,2vw,18px);align-content:center;min-width:0}
.row .txt .eyebrow{color:var(--amber)}
.row h3{font-size:clamp(30px,4vw,48px)}
.row .txt p{color:var(--muted)}
.row .meta{display:flex;flex-wrap:wrap;gap:8px}
.row .meta span{border:1px solid var(--line);border-radius:999px;padding:5px 13px;font-size:13px;color:var(--fg);font-variant-numeric:tabular-nums}
.row .pr{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:6px}
.row .pr .v{font-family:var(--font-display);font-size:54px;line-height:1;font-variant-numeric:tabular-nums}
.row .pr .v small{font:300 13px var(--font-body);color:var(--muted);margin-left:6px}

/* features */
.feat{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:34px 28px;max-width:960px;margin:0 auto}
.feat>div{display:grid;gap:10px;justify-items:center;text-align:center;min-width:0}
.feat .ico{width:46px;height:46px;border-radius:50%;border:1px solid var(--line);background:var(--card);display:grid;place-items:center}
.feat svg{width:22px;height:22px;stroke:var(--amber);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.feat strong{font-weight:500;font-size:16px}
.feat span.t{color:var(--muted);font-size:14.5px;max-width:30ch}

/* route */
.route{display:grid;grid-template-columns:1.25fr .75fr;gap:20px;align-items:start}
.map{background:linear-gradient(180deg,#0e4a55,#0a2f3a);border-radius:28px;overflow:hidden;border:1px solid var(--line);min-width:0}
.map svg{display:block;width:100%;height:auto}
.stop{cursor:pointer}
.stop circle.dot{fill:#0a1214;stroke:var(--fg);stroke-width:2.5;transition:fill .2s ease}
.stop text{font:600 13px var(--font-body);fill:var(--fg);pointer-events:none}
.stop.on circle.dot{fill:var(--amber);stroke:var(--amber)}
.stop.on text{fill:#1a0e03}
.stop circle.ring{fill:none;stroke:var(--amber);stroke-width:2.5;opacity:0;transform-box:fill-box;transform-origin:center}
.stop.on circle.ring{opacity:1;animation:ping 1.6s ease-out infinite}
@keyframes ping{from{transform:scale(1);opacity:.9}to{transform:scale(2.3);opacity:0}}
.flow{animation:flow 1.5s linear infinite}
@keyframes flow{to{stroke-dashoffset:-28}}
.pin{transition:transform .7s cubic-bezier(.5,0,.2,1)}
.panel{background:var(--card);border:1px solid var(--line);border-radius:28px;padding:20px;display:grid;gap:14px;min-width:0}
.panel .now{background:rgba(255,255,255,.05);border:1px solid var(--line);border-radius:20px;padding:18px 20px;min-height:140px}
.panel .now time{font-family:var(--font-display);font-size:42px;color:var(--amber);font-variant-numeric:tabular-nums;line-height:1}
.panel .now h3{font-size:26px;margin-top:8px}
.panel .now p{color:var(--muted);font-size:14.5px;margin-top:6px}
.stops{display:grid;gap:4px}
.stops button{display:flex;align-items:center;gap:12px;text-align:left;width:100%;background:transparent;border:1px solid transparent;border-radius:14px;padding:9px 12px;cursor:pointer;color:var(--fg);font-size:15px;font-weight:400;transition:background .2s ease}
.stops button:hover{background:rgba(255,255,255,.05)}
.stops button b{font-weight:500;font-variant-numeric:tabular-nums;width:46px;flex:none;color:var(--muted)}
.stops button[aria-pressed="true"]{background:rgba(255,255,255,.06);border-color:rgba(240,164,90,.5)}

/* planner */
.book{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(24px,5vw,64px);align-items:start}
.book h2{font-size:clamp(38px,6vw,76px)}
.book p.lead{color:var(--muted);font-size:17px;margin-top:16px;max-width:38ch}
.steps{list-style:none;margin:28px 0 0;padding:0;display:grid;gap:14px;counter-reset:s}
.steps li{display:flex;gap:14px;align-items:flex-start;color:rgba(236,233,226,.85);counter-increment:s}
.steps li::before{content:counter(s);flex:none;width:30px;height:30px;border-radius:50%;border:1px solid var(--amber);color:var(--amber);font-weight:500;display:grid;place-items:center;font-size:13px}
.card{background:var(--glass);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);border:1px solid rgba(255,255,255,.14);border-radius:30px;padding:clamp(20px,3vw,32px);display:grid;gap:20px;min-width:0;box-shadow:0 40px 80px -40px rgba(0,0,0,.8)}
.card h4{margin:0 0 10px;font-size:12px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
.opts{display:grid;gap:8px}
.opt input{position:absolute;opacity:0;pointer-events:none}
.opt label{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid var(--line);border-radius:18px;padding:14px 18px;cursor:pointer;transition:border-color .2s ease,background .2s ease,transform .2s ease}
.opt label:hover{border-color:rgba(255,255,255,.3);transform:translateX(3px)}
.opt label small{display:block;color:var(--muted);font-size:13px}
.opt label b{font-family:var(--font-display);font-weight:400;font-size:30px;font-variant-numeric:tabular-nums}
.opt input:checked+label{border-color:var(--amber);background:rgba(240,164,90,.09)}
.opt input:focus-visible+label{outline:2px solid var(--amber);outline-offset:2px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.card input[type=date]{width:100%;font:400 16px var(--font-body);padding:12px 14px;border:1px solid var(--line);border-radius:16px;color:var(--fg);background:rgba(255,255,255,.04);min-height:52px}
.step{display:flex;align-items:center;justify-content:space-between;border:1px solid var(--line);border-radius:16px;padding:6px 8px 6px 14px;min-height:52px}
.step .ctl{display:flex;align-items:center;gap:6px}
.step button{width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:rgba(255,255,255,.06);color:var(--fg);font-size:19px;cursor:pointer;line-height:1;transition:background .2s ease,transform .15s ease}
.step button:hover:not(:disabled){background:rgba(255,255,255,.16)}
.step button:active:not(:disabled){transform:scale(.9)}
.step button:disabled{opacity:.3;cursor:not-allowed}
.step .n{min-width:22px;text-align:center;font-weight:500;font-variant-numeric:tabular-nums}
.sum{background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:20px;padding:18px 20px;display:grid;gap:8px}
.sum .ln{display:flex;justify-content:space-between;gap:12px;font-size:15px;font-variant-numeric:tabular-nums}
.sum .tot{border-top:1px dashed rgba(255,255,255,.18);padding-top:12px;margin-top:4px;align-items:baseline;font-size:15px}
.sum .tot b{font-family:var(--font-display);font-weight:400;font-size:46px;color:var(--amber);letter-spacing:-.02em}
.sum .dep{color:var(--muted);font-size:14px}
.warn{font-size:13px;color:var(--muted);min-height:20px}
.msg{font-size:14px;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:16px;padding:12px 14px;color:var(--muted);user-select:all;overflow-wrap:anywhere}
.actions{display:grid;gap:10px}
.fine{font-size:13px;color:var(--muted);text-align:center}

/* reviews mosaic */
.mosaic{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.rev{background:var(--card);border:1px solid var(--line);border-radius:26px;padding:24px;display:grid;gap:16px;align-content:space-between;min-width:0;min-height:210px}
.rev.big{grid-column:span 2}
.rev p{font-family:var(--font-display);font-size:clamp(22px,2.4vw,30px);line-height:1.18}
.rev .who{display:flex;align-items:center;gap:12px;font-size:13.5px;color:var(--muted)}
.av{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;font-weight:500;color:#1a0e03;background:linear-gradient(135deg,#ffd9a8,#f0a45a);flex:none}
.av.b{background:linear-gradient(135deg,#9be7e2,#3aa9ac)}
.av.c{background:linear-gradient(135deg,#d9c8ff,#8a74d8)}
.stars{display:flex;gap:3px}
.stars svg{width:15px;height:15px;fill:var(--amber)}

/* faq */
.faq{display:grid;gap:10px;max-width:760px;margin:0 auto}
details{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:0 22px}
summary{cursor:pointer;list-style:none;padding:19px 0;font-weight:500;display:flex;justify-content:space-between;gap:16px;align-items:center}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";flex:none;width:30px;height:30px;border-radius:50%;border:1px solid var(--line);color:var(--amber);font-size:20px;display:grid;place-items:center;transition:transform .25s ease}
details[open] summary::after{transform:rotate(45deg)}
details p{padding-bottom:20px;color:var(--muted)}

.final{text-align:center;display:grid;gap:18px;justify-items:center;padding-block:clamp(40px,7vw,90px)}
.final h2{font-size:clamp(38px,6.6vw,88px);max-width:14ch}
.final p{color:var(--muted);max-width:44ch}
.final .num{font-family:var(--font-display);font-size:30px;color:var(--fg);font-variant-numeric:tabular-nums}
